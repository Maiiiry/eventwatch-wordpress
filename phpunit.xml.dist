<?xml version="1.0"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
>
	<testsuites>
		<testsuite name="eventwatch">
			<directory suffix="-test.php">tests/phpunit</directory>
		</testsuite>
	</testsuites>
</phpunit>
