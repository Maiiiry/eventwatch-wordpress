{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "eventwatch/event-search",
	"version": "0.1.0",
	"title": "Event Search",
	"category": "widgets",
	"icon": "search",
	"description": "Let visitors search your upcoming events by keyword, dates, category, and prefecture.",
	"keywords": [ "event", "search", "filter" ],
	"textdomain": "eventwatch",
	"attributes": {
		"layout": {
			"type": "string",
			"enum": [ "cards", "list" ],
			"default": "cards"
		},
		"perPage": {
			"type": "integer",
			"default": 6
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": [ "file:./style-index.css", "eventwatch-event-list-style" ],
	"render": "file:./render.php"
}
