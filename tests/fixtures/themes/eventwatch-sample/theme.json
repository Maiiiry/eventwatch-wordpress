{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f4efe3" },
				{ "slug": "base-2", "name": "Base 2", "color": "#e9e2cf" },
				{ "slug": "contrast", "name": "Contrast", "color": "#23261f" },
				{ "slug": "contrast-2", "name": "Contrast 2", "color": "#57594c" },
				{ "slug": "contrast-3", "name": "Contrast 3", "color": "#77786a" },
				{ "slug": "accent", "name": "Accent", "color": "#2e5a3a" },
				{ "slug": "line", "name": "Line", "color": "#d3cab3" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "body", "name": "Body", "fontFamily": "\"BIZ UDPGothic\", sans-serif" },
				{ "slug": "heading", "name": "Heading", "fontFamily": "\"Shippori Mincho\", serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" }
			]
		},
		"layout": {
			"contentSize": "960px",
			"wideSize": "1200px"
		},
		"custom": {
			"radius": "6px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		}
	}
}
